# criteria.agency — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it contains secrets

# ── Database ──
DATABASE_URL=postgresql://criteriafilms:criteriafilms@localhost:5432/criteriafilms
STORAGE_PATH=./storage
PORT=3000
GATE_PASS_RATE=0.8

# ── Base URL ──
BASE_URL=http://localhost:3000
WEB_URL=http://localhost:3001

# ── Auth (Better Auth) ──
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Google OAuth (Social Login) ──
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: {BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Founder (receives notifications) ──
FOUNDER_EMAIL=your@email.com

# ── Email (Resend) ──
# Leave empty for console-only mode (no real emails sent)
RESEND_API_KEY=

# ── Payments (Stripe) ──
# Leave empty for mock mode. Run `npm run stripe:setup` to create products.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_STARTER_EARLY_PRICE_ID=
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_EARLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# ── AI Models ──
# Leave empty for mock mode. Agents fall back to mock per-provider.
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
PIAPI_API_KEY=

# ── Admin ──
# Optional: protect API routes with a key (for CLI/scripts)
ADMIN_API_KEY=

# ═══════════════════════════════════════════
# PRODUCTION DEPLOYMENT (Vercel + Backend)
# ═══════════════════════════════════════════
#
# Frontend (Vercel) env vars — set in Vercel dashboard:
#   DATABASE_URL        → Cloud PostgreSQL (Neon, Vercel Postgres, Supabase)
#   RESEND_API_KEY      → Resend production key
#   NEXT_PUBLIC_API_URL → Backend URL (e.g. https://api.criteria.agency)
#
# Backend (Docker/VPS) env vars — set in .env:
#   DATABASE_URL        → Same cloud PostgreSQL
#   BETTER_AUTH_SECRET  → openssl rand -base64 32 (MUST be 32+ chars)
#   BASE_URL            → https://api.criteria.agency
#   WEB_URL             → https://criteria.agency
#   All Stripe, AI, Resend keys
