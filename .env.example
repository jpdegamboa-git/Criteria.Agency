# criteria.agency API — Environment Variables
# Copy to .env and fill in values

# Server
PORT=3001
LOG_LEVEL=info    # debug | info | warn | error

# Database (Step 0.2)
DATABASE_URL=postgresql://user:password@host:5432/criteria

# Auth (Step 0.3)
BETTER_AUTH_SECRET=generate-a-random-secret   # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3001          # API base URL for auth callbacks

# Inngest (Step 0.6) — DEC-140, DEC-148
INNGEST_DEV=1                               # Set to 1 for local dev (no signing key needed)
# In production: remove INNGEST_DEV and set signing key for webhook HMAC-SHA256 verification
# INNGEST_EVENT_KEY=your-event-key          # For sending events
# INNGEST_SIGNING_KEY=your-signing-key      # SYSTEM SECRET — webhook verification

# AI Providers (Step 0.7) — DEC-141, DEC-228, DEC-149
# Tier A (confidential data — Brand Builder, Strategist, Analyst, MARA): Anthropic only
ANTHROPIC_API_KEY=sk-ant-...

# Tier C (public summaries only — Output Registry embeddings): Google Gemini
# Get key at https://aistudio.google.com/app/apikey
# If not configured, Output Registry stores outputs without embeddings (semantic search disabled; list fallback active)
GOOGLE_AI_API_KEY=AIza...

# Langfuse — LLM observability (tokens/cost/latency per agent per tenant) — DEC-228
# Create account at https://cloud.langfuse.com (or self-host)
# If not configured, LLM calls go directly to Anthropic without observability logging
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # optional — override for self-hosted instance

# Cloudflare R2 — artifact storage (Step 2.8) — DEC-007
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=criteria-artifacts
R2_ACCOUNT_ID=...                    # Cloudflare account ID (for endpoint URL)
# R2 endpoint: https://{ACCOUNT_ID}.r2.cloudflarestorage.com

# Vercel — site deploy (Step 2.10)
VERCEL_TOKEN=...                     # Personal access token from vercel.com/account/tokens
VERCEL_TEAM_ID=...                   # team_ prefix (from team settings) — omit if personal account
VERCEL_PROJECT_ID=...                # prj_ prefix (from project settings)
